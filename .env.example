# ==============================================================================
# HAZY PORTFOLIO - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Receiver Inbox (Where you want messages to be delivered)
CONTACT_RECEIVER_EMAIL=

# ------------------------------------------------------------------------------
# 2. THIRD-PARTY EMAIL SERVICES (Choose ANY ONE of the following options)
# ------------------------------------------------------------------------------

# OPTION A: Web3Forms (Recommended - Free, instant setup in 10 seconds)
# 1. Go to https://web3forms.com
# 2. Enter santillankyrell@gmail.com and click "Create Access Key"
# 3. Paste the key sent to your email below:
WEB3FORMS_ACCESS_KEY=

# OPTION B: Resend (Industry standard Next.js / Vercel API)
# 1. Sign up at https://resend.com
# 2. Generate an API Key and paste below:
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OPTION C: Formspree (Form backend)
# 1. Create a form at https://formspree.io
# 2. Paste your form ID (e.g. mzbqrqkw) below:
FORMSPREE_ID=

# OPTION D: Gmail SMTP (Send via personal Gmail using Google App Password)
# 1. Go to Google Account > Security > 2-Step Verification > App Passwords
# 2. Generate an App Password for "Mail"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# OPTION E: Discord or Slack Webhook (Instant ping on your phone / desktop)
# 1. In Discord channel settings > Integrations > Webhooks > Create Webhook
# 2. Copy and paste webhook URL below:
CONTACT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. GitHub API (Used for automated stats / commit ticker)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
